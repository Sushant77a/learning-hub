# Copy this file to .env. The start scripts load it automatically.
# Everything except AI is optional. Learning Hub works fully offline.

# ---- AI (on demand only) -------------------------------------------------
# Supported providers: openai | anthropic | ollama | openai-compatible
# Default provider: openai
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4.1-mini
# AI_BASE_URL=https://api.openai.com/v1

# Anthropic example:
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-sonnet-4-5

# Local Ollama example (no key required):
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5-coder:7b
# AI_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible gateway:
# AI_PROVIDER=openai-compatible
# AI_API_KEY=...
# AI_MODEL=...
# AI_BASE_URL=https://your-gateway.example/v1

# ---- Local server --------------------------------------------------------
# LEARNINGHUB_URL=http://localhost:5180
# Override to use your own MySQL instead of the Docker container:
# LEARNINGHUB_DB=Server=127.0.0.1;Port=3306;Database=learninghub;User ID=root;Password=secret;

# Skip the Docker step in start scripts when you already run MySQL:
# LEARNINGHUB_SKIP_DOCKER=1

# ---- Optional Google Calendar -------------------------------------------
# Off by default. The app is complete without this.
# Create an OAuth web application in Google Cloud Console and add
# http://localhost:5180/api/calendar/google/callback as a redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5180/api/calendar/google/callback
